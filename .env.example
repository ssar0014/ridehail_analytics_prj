# Copy to .env and adjust. Docker Compose reads it for the containers; the API
# (api/config.py) and db/connection.py also read it when run locally.

# ── required ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# ── database credentials (used by the containers themselves) ──────────────────
# Postgres/ClickHouse only apply these when their data volume is first created;
# changing them later doesn't change the existing password.
POSTGRES_USER=ridehail
POSTGRES_PASSWORD=ridehail
POSTGRES_DB=ridehail_db
CLICKHOUSE_USER=ridehail
CLICKHOUSE_PASSWORD=ridehail
CLICKHOUSE_DATABASE=ridehail

# ── host port for the web app container ───────────────────────────────────────
WEB_PORT=8080

# ── local (non-Docker) API / scripts ──────────────────────────────────────────
# Inside Compose these are set per-container; these values are for running on
# the host against the published 127.0.0.1 ports.
DATABASE_URL=postgresql://ridehail:ridehail@localhost:5432/ridehail_db
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
ACCESS_TOKEN_TTL_MINUTES=60
# JSON list of allowed browser origins (only needed when not using the Vite proxy)
CORS_ORIGINS=["http://localhost:5173"]
